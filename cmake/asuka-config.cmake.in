# Config file for the asuka package
#
# Usage from an external project:
#
#  find_package(asuka REQUIRED)
#  target_link_libraries(MY_TARGET_NAME asuka::asuka_core)
#
@PACKAGE_INIT@

include_guard()

include(CMakeFindDependencyMacro)
find_dependency(Boost REQUIRED)
find_dependency(Eigen3 REQUIRED)
find_dependency(PCL REQUIRED)
find_dependency(spdlog REQUIRED)
find_dependency(OpenMP REQUIRED)
find_dependency(OpenCV REQUIRED COMPONENTS core)

include("${CMAKE_CURRENT_LIST_DIR}/asuka-targets.cmake")

check_required_components(asuka)
