    "history_keyframe_search_radius": 10.0,
    "history_keyframe_search_time_diff": 30.0,
    "history_keyframe_search_num": 25,
    "loop_noise_score": 0.5,
    "graph_update_times": 2,
    "loop_fitness_score_threshold": 0.3,
    "loop_closure_frequency": 2.0,
    "graph_update_frequency": 1.0,
    "vizmap_frequency": 0.1,
    "publish_rate": 10.0,
    "mapviz_filter_size": 0.4
