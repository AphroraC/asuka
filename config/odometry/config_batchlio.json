{
  "odometry": {
    "so_name": "libasuka_odometry_batchlio.so",
    "imu_buffer_capacity": 1000,
    "lidar_buffer_capacity": 50
  },
  "batch": {
    "dt": 0.001,
    "deskew": true,
    "enable_openmp": false
  },
  "mapping": {
    "imu_en": true,
    "lidar_time_inte": 0.1,
    "satu_acc": 3.0,
    "satu_gyro": 35.0,
    "acc_norm": 9.80665,
    "acc_cov_output": 500.0,
    "gyr_cov_output": 1000.0,
    "b_acc_cov": 0.0001,
    "b_gyr_cov": 0.0001,
    "imu_meas_acc_cov": 0.1,
    "imu_meas_omg_cov": 0.1,
    "gyr_cov_input": 0.01,
    "acc_cov_input": 0.1,
    "vel_cov": 20.0,
    "plane_thr": 0.1,
    "match_s": 81.0,
    "ivox_grid_resolution": 2.0,
    "ivox_nearby_type": 18,
    "init_map_size": 100, // avia.yaml effective default (was 10)
    "space_down_sample": true,
    // false = upstream default. The 2026-09-17 "false diverges from ~38%" observation
    // was root-caused 2026-09-26 to the IMU-measurement saturation gate comparing the
    // SI (m/s^2) acc feed against the g-unit satu_acc threshold (3.0), permanently
    // zeroing the acc rows of update_iterated_dyn_share_IMU; the gate is now unit-aware
    // (threshold scaled by acc_norm) and false is verified to close the liantiao loop.
    "use_imu_as_input": false,
    "prop_at_freq_of_imu": true,
    "check_satu": true,
    "gravity": [
      0.0,
      0.0,
      -9.810
    ],
    "gravity_init": [
      0.0,
      0.0,
      -9.810
    ],
    "lidar_meas_cov": 0.01
  },
  "preprocess": {
    "min_distance": 0.5,
    "max_distance": 1000.0,
    "point_filter_num": 2, // avia.yaml default (was 1)
    "scan_line": 6,
    "scan_rate": 10
  },
  "filter": {
    "filter_size_surf": 0.5,
    "filter_size_map": 0.5 // avia.yaml default (was 0.4)
  },
  "publish": {
    "scan_publish_en": true,
    "scan_bodyframe_pub_en": true
  },
  "sensor": {
    "extrinsic_T": [
      -0.011,
      -0.02329,
      0.04412
    ],
    "extrinsic_R": [
      1,
      0,
      0,
      0,
      1,
      0,
      0,
      0,
      1
    ],
    "gyro_noise": [
      0.1,
      0.1,
      0.1
    ],
    "acc_noise": [
      0.1,
      0.1,
      0.1
    ],
    "gyro_bias": [
      0.0001,
      0.0001,
      0.0001
    ],
    "acc_bias": [
      0.0001,
      0.0001,
      0.0001
    ],
    "gyr_cov": 0.1,
    "acc_cov": 0.1,
    "b_gyr_cov": 0.0001,
    "b_acc_cov": 0.0001
  }
}